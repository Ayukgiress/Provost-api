  "info": {
    "title": "Provost API",
    "description": "Scholarship, fellowship & grant discovery and application tracking",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "citizenship": {
            "type": "object",
            "example": "US"
          },
          "residenceCountry": {
            "type": "object",
            "example": "CA"
          },
          "deadlineRemindersEnabled": {
            "type": "boolean",
            "description": "Opt out of deadline reminder emails",
            "default": true
          },
          "birthYear": {
            "type": "object",
            "example": 1998,
            "minimum": 1900,
            "maximum": 2100
          },
          "educationLevel": {
            "type": "string",
            "enum": [
              "high_school",
              "bachelor",
              "master",
              "phd",
              "professional"
            ]
          },
          "fieldOfStudy": {
