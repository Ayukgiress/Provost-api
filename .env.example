# ─────────────────────────────────────────────────────────────
# Provost API — environment variables
# Copy this file to `.env` and fill in the values.
# All variables are validated at startup with Zod; the app
# refuses to start if any required value is missing or invalid.
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | production | test
NODE_ENV=development

# Port the HTTP API listens on
PORT=3000

# Port the worker's /health endpoint listens on
WORKER_PORT=3001

# Comma-separated CORS origin allowlist
CORS_ORIGINS=http://localhost:3000,http://10.117.235.206:3000,http://localhost:5173

# ── Database (PostgreSQL / Supabase) ─────────────────────────
# For local development, use the docker-compose Postgres:
DATABASE_URL=postgresql://provost:provost@localhost:5432/provost
# For Supabase, use the connection string from the dashboard:
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ── Supabase Auth (JWT verification) ─────────────────────────
# The API only VERIFIES JWTs issued by Supabase Auth — it never
# issues them. Provide EITHER the JWT secret OR the JWKS URL.
#
# Option A: shared JWT secret (from Supabase dashboard > Settings > API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
#
# Option B: JWKS URL (preferred for key rotation)
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
#
# Optional: expected token issuer (e.g. https://your-project.supabase.co/auth/v1)
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# Optional Supabase admin credentials are required by DELETE /me. Keep these
# server-side only; the service-role key must never be exposed to clients.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=scholarship-docs

# ── Scraper & extraction ────────────────────────────────────
# The worker scrapes sources from the `sources` table. Seed sources first:
#   pnpm seed:sources
#
# Extraction uses an OpenAI-compatible LLM to parse scraped text into
# structured opportunity data. Point it at local Ollama or a cloud provider.
SCRAPER_USER_AGENT=ProvostBot/1.0
SCRAPER_CONTACT_EMAIL=contact@provost.app
SCRAPER_DOMAIN_DELAY_MS=1500
SCRAPER_TIMEOUT_MS=20000
# TRUSTED_OFFICIAL_DOMAINS=fulbrightprogram.org,chevening.org
#
# Option A: local Ollama (free, already used by the assistant)
EXTRACTION_PROVIDER=openai-compatible
EXTRACTION_API_KEY=ollama
EXTRACTION_BASE_URL=http://localhost:11434/v1
EXTRACTION_MODEL=qwen2.5:7b
#
# Option B: OpenAI
# EXTRACTION_PROVIDER=openai-compatible
# EXTRACTION_API_KEY=sk-...
# EXTRACTION_BASE_URL=https://api.openai.com/v1
# EXTRACTION_MODEL=gpt-4o-mini

# ── In-app assistant ────────────────────────────────────────
# Local Ollama is free; install Ollama and pull the configured models.
# The API remains available (including /health) when Ollama is unavailable.
ASSISTANT_NAME=Provost
AI_PROVIDER=ollama
# Optional for local Ollama; do not commit remote-provider secrets.
# AI_API_KEY=
AI_BASE_URL=http://localhost:11434
AI_MODEL_FAST=qwen2.5:3b
AI_MODEL_STRONG=qwen2.5:7b
ASSISTANT_LIMIT_FREE=5
ASSISTANT_LIMIT_PLUS=50

# ── Rate limiting ────────────────────────────────────────────
# Window (seconds) and max requests per window per IP.
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# ── Swagger ──────────────────────────────────────────────────
# Swagger is served at /docs. It is disabled in production
# unless explicitly enabled here.
# SWAGGER_ENABLED=true

# ── Logging ──────────────────────────────────────────────────
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Pretty-print logs in development (set false in production for JSON)
LOG_PRETTY=true
